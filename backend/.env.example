# Local development defaults. Replace the secrets before production use.
NODE_ENV=development

JWT_ACCESS_SECRET=local-development-access-secret-change-before-production
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-production
INTERNAL_SERVICE_KEY=local-development-internal-key

FRONTEND_URL=http://localhost:3000
GATEWAY_PORT=4000
USER_SERVICE_PORT=4002
AUTH_SERVICE_PORT=4001
INVOICE_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004

AUTH_MONGO_URI=mongodb://127.0.0.1:27017/iris_auth
USER_MONGO_URI=mongodb://127.0.0.1:27017/iris_users
INVOICE_MONGO_URI=mongodb://127.0.0.1:27017/iris_invoices
NOTIFICATION_MONGO_URI=mongodb://127.0.0.1:27017/iris_notifications
MONGO_PORT=27017

AUTH_SERVICE_URL=http://127.0.0.1:4001
USER_SERVICE_URL=http://127.0.0.1:4002
INVOICE_SERVICE_URL=http://127.0.0.1:4003
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4004
UPLOAD_DIR=services/invoice-service/uploads

BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SERVICE_REQUEST_TIMEOUT=15000

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
DEV_RETURN_OTP=false

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_KEY=
